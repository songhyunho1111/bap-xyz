+import { expect, test } from "bun:test";
+import { sourcesFromProviders } from "@/mcp/server";
+import { initializeRegistry } from "@/providers/init";
+
+test("only registers Dimigo for HTTP, MCP, and scheduled collection", () => {
+  const registry = initializeRegistry();
+  expect(registry.getProviders().map((provider) => provider.config.id)).toEqual(["kdmhs"]);
+  expect(sourcesFromProviders(registry.getProviders()).map((source) => source.id)).toEqual(["kdmhs"]);
+  expect(registry.findByPath("/dgu/health")).toBeUndefined();
+  expect(registry.findByPath("/horang/health")).toBeUndefined();
+  expect(initializeRegistry().getProviders()).toHaveLength(1);
+});
