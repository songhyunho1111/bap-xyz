+import { afterEach, describe, expect, spyOn, test } from "bun:test";
+import { getCatalog } from "@/shared/lib/catalog";
+
+afterEach(() => fetchSpy.mockRestore());
+let fetchSpy: ReturnType<typeof spyOn<typeof globalThis, "fetch">>;
+
+describe("Dimigo catalog", () => {
+  test("only exposes Dimigo even when the API still returns other schools", async () => {
+    fetchSpy = spyOn(globalThis, "fetch");
+    const dimigo = { id: "kdmhs", basePath: "/kdmhs", meals: [] };
+    fetchSpy.mockResolvedValue(
+      Response.json({
+        providers: [
+          { id: "horang", basePath: "/horang", meals: [] },
+          dimigo,
+          { id: "dgu", basePath: "/dgu", meals: [] },
+          null,
+        ],
+      }),
+    );
+    expect(await getCatalog()).toEqual([dimigo]);
+  });
+
+  test("does not fall back to another school when Dimigo is unavailable", async () => {
+    fetchSpy = spyOn(globalThis, "fetch");
+    fetchSpy.mockResolvedValue(Response.json({ providers: [{ id: "dgu", basePath: "/dgu", meals: [] }] }));
+    expect(await getCatalog()).toEqual([]);
+  });
+
+  test("handles invalid catalogs and API failures", async () => {
+    fetchSpy = spyOn(globalThis, "fetch");
+    for (const body of [{}, { providers: null }, { providers: [{ id: "kdmhs" }] }]) {
+      fetchSpy.mockResolvedValue(Response.json(body));
+      expect(await getCatalog()).toEqual([]);
+    }
+    fetchSpy.mockResolvedValue(new Response(null, { status: 503 }));
+    expect(await getCatalog()).toEqual([]);
+    fetchSpy.mockRejectedValue(new Error("offline"));
+    expect(await getCatalog()).toEqual([]);
+  });
+});
